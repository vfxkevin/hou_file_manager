{
	"fileversion":"20.5.487",
	"name":"kev_quick_menu",
	"categories":"Standard",
	"pane":"network",
	"label":"Kev Quick Menu",
	"type":"script_submenu",
	"script":"## Kevin Quick Radial Menu ##\nRED = hou.Color((1, 0, 0))\nGREEN = hou.Color((0, 1, 0))\nBLUE = hou.Color((0, 0, 1))\n\npane = kwargs['pane']\nparent = pane.pwd()\ncur_position = pane.cursorPosition()\nselected = hou.selectedNodes()\nentries = {}\n\ndef create_node(parent, node_type, node_name=None, color=None, position=None, set_current=True, clear_all_selected=True):\n    try:\n        node = parent.createNode(node_type)\n    except Exception:\n        return None\n    if node_name:\n        node.setName(node_name, unique_name=True)\n    if color:\n        node.setColor(color)\n    if position:\n        node.setPosition(position)\n    node.setCurrent(True, clear_all_selected)\n    return node\n    \ndef create_null(pane, connection_type, name, color):\n    if not selected:\n        create_node(parent, 'null', name, color, cur_position)\n        return\n\n    for n in selected:\n        null = create_node(parent, 'null', name, color)\n        if not null:\n            continue\n        if connection_type == 'out':\n            # Connect only first output connections to the null node's output first.\n            out_con = n.outputConnections()\n            for con in out_con:\n                con_node = con.outputNode()\n                con_index = con.inputIndex()\n                if con.outputIndex() == 0:\n                    con_node.setInput(con_index, null)\n            # Then connect the input of null to output of selected node.\n            null.setInput(0, n)\n            null.moveToGoodPosition(move_inputs=False)\n            # set display and render flag for out nulls\n            null.setDisplayFlag(True)\n            try:\n                null.setRenderFlag(True)\n            except Exception:\n                pass\n        elif connection_type == 'in':\n            in_con = n.inputConnections()\n            for con in in_con:\n                con_node = con.inputNode()\n                con_index = con.outputIndex()\n                if con.inputIndex() == 0:\n                    null.setInput(0, con_node, con_index)\n            n.setInput(0, null)\n            null.moveToGoodPosition(relative_to_inputs=False, move_outputs=False)\n\nif pane.type() == hou.paneTabType.NetworkEditor:\n   \n    def out_null(pane):\n        create_null(pane, 'out', 'OUT', RED)\n            \n    def in_null(pane):\n        create_null(pane, 'in', 'IN', GREEN)\n        \n    def obj_merge(pane):\n        if not selected:\n            create_node(parent, 'object_merge', position=cur_position)\n            return\n            \n        for n in selected:\n            if parent.type().name() != 'geo':\n                continue\n            obj_merge = create_node(parent, 'object_merge', color=GREEN)\n            if not obj_merge:\n                continue\n            n_pos = n.position()\n            n_path = n.path()\n            offset = hou.Vector2((1.5, 0))\n            obj_merge.setPosition(n_pos + offset)\n            parm = obj_merge.parm('objpath1')\n            if parm:\n                parm.set(n_path)\n        \n    def merge(pane):\n        merge_node = create_node(parent, 'merge', position=cur_position)\n        if not merge_node:\n            return\n        for n in selected:\n            merge_node.setNextInput(n)\n        \n    def add_switch(pane):\n        switch_node = create_node(parent, 'switch', position=cur_position)\n        if not switch_node:\n            return\n        for n in selected:\n            switch_node.setNextInput(n)\n                \n    def file_manager(pane):\n        desktop = hou.ui.curDesktop()\n\n        desktop.createFloatingPaneTab(\n            hou.paneTabType.PythonPanel, \n            python_panel_interface='hou_file_manager'\n            )\n            \n    def create_geo(pane):\n        if parent.type().name() == 'obj':\n            geo = create_node(parent, 'geo')\n            geo.setPosition(cur_position)\n            \n    def file_cache(pane):\n        if not selected:\n            create_node(parent, 'filecache', position=cur_position)\n            return\n\n        for n in selected:\n            cache = create_node(parent, 'filecache', 'filecache_please_change_name')\n            if not cache:\n                continue\n            # Connect all the output connections to the null node's output first.\n            out_con = n.outputConnections()\n            for con in out_con:\n                con_node = con.outputNode()\n                con_index = con.inputIndex()\n                con_node.setInput(con_index, cache)\n            # Then connect the input of null to output of selected node.\n            cache.setInput(0, n)\n            cache.moveToGoodPosition(move_inputs=False)\n            \n    def transform(pane):\n        if not selected:\n            create_node(parent, 'xform', position=cur_position)\n            return\n\n        for n in selected:\n            xform = create_node(parent, 'xform')\n            if not xform:\n                continue\n            # Connect all the output connections to the null node's output first.\n            out_con = n.outputConnections()\n            for con in out_con:\n                con_node = con.outputNode()\n                con_index = con.inputIndex()\n                con_node.setInput(con_index, xform)\n            # Then connect the input of null to output of selected node.\n            xform.setInput(0, n)\n            xform.moveToGoodPosition(move_inputs=False)\n\n    def make_sub_menu(**kwargs):\n        menu = {\n\n            'w': {\n                'type'    :'script_action',\n                'label'   : 'Transform',\n                'icon'    : 'SOP_xform',\n                'script'  : transform,\n            },\n            's': {\n                'type'    :'script_action',\n                'label'   : 'File Cache',\n                'icon'    : 'SOP_filecache',\n                'script'  : file_cache,\n            },\n        }\n        radialmenu.setRadialMenu(menu)\n        \n    entries = {\n        'n': {\n            'type'    :'script_action',\n            'label'   : 'File Manager',\n            'script'  : file_manager,\n        },\n        'ne': {\n            'type'    :'script_action',\n            'label'   : 'Obj Merge',\n            'icon'    : 'SOP_object_merge',\n            'script'  : obj_merge,\n        },\n        'e': {\n            'type'    :'script_action',\n            'label'   : 'Merge',\n            'icon'    : 'SOP_merge',\n            'script'  : merge,\n        },\n        'se': {\n            'type'    :'script_action',\n            'label'   : 'Switch',\n            'icon'    : 'SOP_switch',\n            'script'  : add_switch,\n        },\n        's': {\n            'type'    :'script_submenu',\n            'label'   : 'Others',\n            'script'  : make_sub_menu,\n        },\n        'sw': {\n            'type': 'script_action',\n            'label': 'IN NULL',\n            'icon'    : 'SOP_null',\n            'script': in_null\n        },\n        'w': {\n            'type': 'script_action',\n            'label': 'OUT NULL',\n            'icon'    : 'SOP_null',\n            'script': out_null\n        },\n        'nw': {\n            'type'    :'script_action',\n            'label'   : 'Create Geometry',\n            'icon'    : 'OBJ_geo',\n            'script'  : create_geo,\n        } \n    }\n\nradialmenu.setRadialMenu(entries)"
}
