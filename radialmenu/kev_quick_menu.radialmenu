{
	"fileversion":"20.5.410",
	"name":"kev_quick_menu",
	"categories":"Standard",
	"pane":"network",
	"label":"Kev Quick Menu",
	"type":"script_submenu",
	"script":"RED = hou.Color((1, 0, 0))\nGREEN = hou.Color((0, 1, 0))\nBLUE = hou.Color((0, 0, 1))\n\npane = kwargs['pane']\n\nentries = {}\n\nif pane.type() == hou.paneTabType.NetworkEditor:\n    def out_null(pane):\n        selected = hou.selectedNodes()\n\n        for n in selected:\n            parent = n.parent()\n            null = parent.createNode('null', node_name='OUT')\n            null.setColor(RED)\n            # Connect all the output connections to the null node's output first.\n            out_con = n.outputConnections()\n            for con in out_con:\n                con_node = con.outputNode()\n                con_index = con.inputIndex()\n                con_node.setInput(con_index, null)\n            # Then connect the input of null to output of selected node.\n            null.setInput(0, n)\n            null.moveToGoodPosition()\n            null.setDisplayFlag(True)\n            null.setRenderFlag(True)\n        \n    def obj_merge(pane):\n        for n in hou.selectedNodes():\n            n_pos = n.position()\n            n_path = n.path()\n            parent = n.parent()\n            if parent.type().name() != 'geo':\n                continue\n            obj_merge = parent.createNode('object_merge')\n            obj_merge.setColor(GREEN)\n            offset = hou.Vector2((1.5, 0))\n            obj_merge.setPosition(n_pos + offset)\n            parm = obj_merge.parm('objpath1')\n            if parm:\n                parm.set(n_path)\n        \n    def merge(pane):\n        selected = hou.selectedNodes()\n        if selected:\n            first_selected = selected[0]\n            first_selected_position = first_selected.position()\n            parent = first_selected.parent()\n            merge = first_selected.parent().createNode('merge')\n            #merge.setColor(BLUE)\n            offset = hou.Vector2((0, -1.5))\n            merge.setPosition(first_selected_position + offset)\n            \n            for n in selected:\n                this_parent = n.parent()\n        \n                if this_parent != parent:\n                    print('this parent is not the same parent')\n                    continue\n        \n                merge.setNextInput(n)\n        \n    def add_switch(pane):\n        BLUE = hou.Color((0, 0, 1))\n\n        selected = hou.selectedNodes()\n        if selected:\n            first_selected = selected[0]\n            first_selected_position = first_selected.position()\n            parent = first_selected.parent()\n            switch_node = first_selected.parent().createNode('switch')\n            #switch_node.setColor(BLUE)\n            offset = hou.Vector2((0, -1.5))\n            switch_node.setPosition(first_selected_position + offset)\n            \n            for n in selected:\n                this_parent = n.parent()\n        \n                if this_parent != parent:\n                    print('this parent is not the same parent')\n                    continue\n        \n                switch_node.setNextInput(n)\n                \n    def file_manager(pane):\n        desktop = hou.ui.curDesktop()\n\n        desktop.createFloatingPaneTab(\n            hou.paneTabType.PythonPanel, \n            python_panel_interface='hou_file_manager'\n            )\n            \n    def create_geo(pane):\n        pwd = pane.pwd()\n        if pwd.type().name() == 'obj':\n            geo = pwd.createNode('geo')\n            geo.moveToGoodPosition()\n            \n    def file_cache(pane):\n        selected = hou.selectedNodes()\n\n        for n in selected:\n            parent = n.parent()\n            null = parent.createNode('filecache', node_name='filecache_plz_change_name')\n            # Connect all the output connections to the null node's output first.\n            out_con = n.outputConnections()\n            for con in out_con:\n                con_node = con.outputNode()\n                con_index = con.inputIndex()\n                con_node.setInput(con_index, null)\n            # Then connect the input of null to output of selected node.\n            null.setInput(0, n)\n            null.moveToGoodPosition()\n            \n    def transform(pane):\n        selected = hou.selectedNodes()\n\n        for n in selected:\n            parent = n.parent()\n            null = parent.createNode('xform')\n            # Connect all the output connections to the null node's output first.\n            out_con = n.outputConnections()\n            for con in out_con:\n                con_node = con.outputNode()\n                con_index = con.inputIndex()\n                con_node.setInput(con_index, null)\n            # Then connect the input of null to output of selected node.\n            null.setInput(0, n)\n            null.moveToGoodPosition()\n\n        \n    entries = {\n        'n': {\n            'type'    :'script_action',\n            'label'   : 'File Manager',\n            # 'icon'    : icon_name,\n            'script'  : file_manager,\n            # 'shortcut': shortcut,\n        },\n        'ne': {\n            'type'    :'script_action',\n            'label'   : 'Obj Merge',\n            # 'icon'    : icon_name,\n            'script'  : obj_merge,\n            # 'shortcut': shortcut,\n        },\n        'e': {\n            'type'    :'script_action',\n            'label'   : 'Merge',\n            # 'icon'    : icon_name,\n            'script'  : merge,\n            # 'shortcut': shortcut,\n        },\n        'se': {\n            'type'    :'script_action',\n            'label'   : 'Switch',\n            # 'icon'    : icon_name,\n            'script'  : add_switch,\n            # 'shortcut': shortcut,\n        },\n        's': {\n            'type'    :'script_action',\n            'label'   : 'Out Null',\n            # 'icon'    : icon_name,\n            'script'  : out_null,\n            # 'shortcut': shortcut,\n        },\n        'sw': {\n            'type'    :'script_action',\n            'label'   : 'Transform',\n            # 'icon'    : icon_name,\n            'script'  : transform,\n            # 'shortcut': shortcut,\n        },\n        'w': {\n            'type'    :'script_action',\n            'label'   : 'File Cache',\n            # 'icon'    : icon_name,\n            'script'  : file_cache,\n            # 'shortcut': shortcut,\n        },\n        'nw': {\n            'type'    :'script_action',\n            'label'   : 'Create Geometry',\n            # 'icon'    : icon_name,\n            'script'  : create_geo,\n            # 'shortcut': shortcut,\n        } \n    }\n\nradialmenu.setRadialMenu(entries)"
}
